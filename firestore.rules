rules_version = '2';

// Quy tắc bảo mật Firestore cho CongCa Coffee.
// Mỗi điện thoại đăng nhập ẩn danh (có uid riêng). Khi nhập đúng PIN, app tạo
// devices/{uid} = { phone, pin }; quy tắc bên dưới tự so PIN với pins/{phone}
// (collection pins không ai đọc được từ app), nên PIN được kiểm tra phía server.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasDevice() {
      return signedIn() && exists(/databases/$(database)/documents/devices/$(request.auth.uid));
    }

    function myPhone() {
      return get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.phone;
    }

    function isAdmin() {
      return hasDevice() && get(/databases/$(database)/documents/users/$(myPhone())).data.role == 'admin';
    }

    function isOwner(phone) {
      return hasDevice() && myPhone() == phone;
    }

    function validPin(pin) {
      return pin is string && pin.matches('^[0-9]{4}$');
    }

    // Lần thiết lập đầu tiên: tạo meta/setup, tài khoản chủ quán, PIN và thiết bị
    // trong cùng một batch. Chỉ chạy được khi meta/setup chưa tồn tại.
    function isBootstrap(phone) {
      return signedIn()
        && !exists(/databases/$(database)/documents/meta/setup)
        && getAfter(/databases/$(database)/documents/meta/setup).data.adminPhone == phone;
    }

    // Khách mới tự đăng ký trong một batch: users + pins + devices cho chính SĐT đó.
    // Chỉ được khi SĐT chưa có tài khoản, và PIN của thiết bị phải khớp PIN vừa tạo.
    function isSelfSignup(phone) {
      return signedIn()
        && !exists(/databases/$(database)/documents/users/$(phone))
        && getAfter(/databases/$(database)/documents/users/$(phone)).data.role == 'customer'
        && getAfter(/databases/$(database)/documents/devices/$(request.auth.uid)).data.phone == phone
        && getAfter(/databases/$(database)/documents/devices/$(request.auth.uid)).data.pin
          == getAfter(/databases/$(database)/documents/pins/$(phone)).data.pin;
    }

    // Quên PIN: khách tự đặt lại bằng SĐT + tên đặt hàng. Cùng một lần ghi phải mở khóa
    // máy này cho SĐT đó, kèm resetName khớp tên trong users/{phone} (không phân biệt hoa thường).
    function nameReset(phone) {
      let d = getAfter(/databases/$(database)/documents/devices/$(request.auth.uid));
      return signedIn()
        && d != null
        && d.data.phone == phone
        && d.data.resetName is string
        && d.data.resetName.lower() == get(/databases/$(database)/documents/users/$(phone)).data.name.lower();
    }

    match /meta/setup {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['adminPhone', 'createdAt'])
        && request.resource.data.adminPhone is string
        && request.resource.data.adminPhone.size() >= 4;
      allow update, delete: if false;
    }

    match /users/{phone} {
      // get một người cụ thể: để màn PIN chào đúng tên. list cả danh sách: chỉ chủ quán.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if request.resource.data.name is string
        && ((isAdmin() && request.resource.data.role == 'customer')
          || (isBootstrap(phone) && request.resource.data.role == 'admin')
          || (request.resource.data.role == 'customer'
            && request.resource.data.keys().hasOnly(['name', 'role'])
            && request.resource.data.name.size() > 0
            && isSelfSignup(phone)));
      allow update: if (isAdmin() && request.resource.data.role == resource.data.role)
        || (isOwner(phone) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0);
      allow delete: if isAdmin() && resource.data.role != 'admin';
    }

    match /pins/{phone} {
      allow read: if false;
      allow create: if validPin(request.resource.data.pin) && (isAdmin() || isBootstrap(phone) || isSelfSignup(phone));
      allow update: if validPin(request.resource.data.pin) && (isAdmin() || isOwner(phone) || nameReset(phone));
      allow delete: if isAdmin();
    }

    match /devices/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.phone is string
        && validPin(request.resource.data.pin)
        && existsAfter(/databases/$(database)/documents/pins/$(request.resource.data.phone))
        && getAfter(/databases/$(database)/documents/pins/$(request.resource.data.phone)).data.pin == request.resource.data.pin;
      allow update: if false;
    }

    match /menu/{itemId} {
      allow read: if hasDevice();
      allow write: if isAdmin();
    }

    // Bộ đếm mã đơn: đơn đầu tiên là #1234, sau đó chỉ được tăng đúng 1 mỗi lần
    match /counters/orders {
      allow read: if hasDevice();
      allow create: if hasDevice() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1234;
      allow update: if hasDevice() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    // Đơn có số thì số đó phải là số bộ đếm vừa tăng lên trong cùng lần ghi
    function validNo() {
      return !('no' in request.resource.data)
        || (request.resource.data.no is int
          && getAfter(/databases/$(database)/documents/counters/orders).data.n == request.resource.data.no
          && (exists(/databases/$(database)/documents/counters/orders)
            ? get(/databases/$(database)/documents/counters/orders).data.n == request.resource.data.no - 1
            : request.resource.data.no == 1234));
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (hasDevice() && resource.data.customerPhone == myPhone());
      // Chủ quán đặt đơn hộ khách (gán số điện thoại của khách), có thể đã thanh toán ngay
      allow create: if validNo() && ((isAdmin() && request.resource.data.totalAmount is number && request.resource.data.customerPhone is string)
        || (hasDevice()
          && request.resource.data.customerPhone == myPhone()
          && request.resource.data.status == 'pending'
          && request.resource.data.paid == false
          && request.resource.data.totalAmount is number
          && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == 'awaiting')));
      // Chủ quán sửa mọi thứ; khách chỉ được tự hủy đơn đang chờ của mình,
      // hoặc báo "đã chuyển khoản" (paymentStatus 'awaiting') cho đơn chưa trả để quán xác nhận
      allow update: if isAdmin()
        || (isOwner(resource.data.customerPhone)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (isOwner(resource.data.customerPhone)
          && resource.data.paid == false
          && request.resource.data.paymentStatus == 'awaiting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus']));
      allow delete: if isAdmin();
    }

    // Token nhận thông báo đẩy của từng thiết bị; chỉ Cloud Functions đọc (qua Admin SDK)
    match /pushTokens/{token} {
      allow read: if false;
      allow create, update: if hasDevice()
        && request.resource.data.phone == myPhone()
        && request.resource.data.keys().hasOnly(['phone', 'uid', 'userAgent', 'updatedAt']);
      allow delete: if hasDevice() && resource.data.phone == myPhone();
    }

    match /transactions/{txId} {
      allow read, write: if isAdmin();
    }
  }
}
